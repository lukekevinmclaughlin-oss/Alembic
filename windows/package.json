{
  "name": "alembic-windows",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Luke McLaughlin",
  "description": "Offline Windows dataset cleaning, training-data preparation and RAG chunking.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-build.mjs && tsc --noEmit && vite build",
    "package:win": "pnpm run build && electron-builder --win dir --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "png-to-ico": "3.0.1",
    "rcedit": "5.0.2",
    "fake-indexeddb": "6.2.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.lukemclaughlin.alembic.windows",
    "afterPack": "build/afterPack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*",
      "content/**/*"
    ],
    "productName": "Alembic",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    },
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    }
  }
}
